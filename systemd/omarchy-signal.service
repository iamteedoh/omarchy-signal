[Unit]
Description=omarchy-signal bridge (signal-cli supervisor and local message store)
Documentation=https://github.com/iamteedoh/omarchy-signal
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-signal bridge
Restart=on-failure
RestartSec=3
# Hardening. The bridge needs: its own XDG dirs, signal-cli's data dir, the
# runtime dir for the socket, and outbound network (signal-cli).
# RuntimeDirectory creates %t/omarchy-signal (0700) on every start, and the
# "-" prefix keeps a not-yet-existing data dir from failing the unit; the
# bridge creates them itself on first run.
RuntimeDirectory=omarchy-signal
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
# libsignal unpacks its native library into /tmp at start-up and ProtectSystem=strict
# makes /tmp read-only, so signal-cli needs a private one. Attachments are therefore
# accepted from the home directory only (see sanitize.safe_attachment_path).
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.local/share/omarchy-signal -%h/.local/share/signal-cli -%h/.local/state/omarchy-signal
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
